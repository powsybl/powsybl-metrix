msgstr "Introduction"

#: ../../metrix.md:6 28723d2b230442eeab6caca319f91db7
msgid "To launch a Metrix simulation, you need:"
msgstr "Pour lancer une simulation Metrix, il faut :"

#: ../../metrix.md:7 d431d2e95c074c41b0a9f5b6d8bd9c2f
msgid "the mapping requirements:"
msgstr "les prérequis du mapping :"

#: ../../metrix.md:8 8f87216728e34cb786fda2ff9c0dc624
msgid "a network in IIDM format"
msgstr "un réseau au format IIDM"

#: ../../metrix.md:9 8755389b60e54bd6a62541dc997dfbb1
msgid "a time series store (csv)"
msgstr "un store de séries temporelles (csv)"

#: ../../metrix.md:10 6a9e8b66fbe842c4907fbb7c967cdd52
