#: ../../metrix.md:497 fc18a4a0f3404897a37e4f15b29e1bb1
msgid "1: No solution was found"
msgstr "1 : Aucune solution n'a été trouvée"

#: ../../metrix.md:498 bb8cacab9fa04b1f8495f7f1020c96c3
